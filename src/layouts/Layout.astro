---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Taunton Somerset Local Business Directory | Find Plumbers, Cleaners, Electricians & More",
  description = "Find trusted local businesses in Taunton, Somerset. Browse our directory of plumbers, cleaners, electricians, builders, gardeners and more. Quality local services at your fingertips."
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteUrl = "https://tauntonsomerset.co.uk";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="Taunton, Somerset, local business, directory, plumbers, cleaners, electricians, builders, gardeners, painters, decorators, local services" />
    <meta name="author" content="TauntonSomerset.co.uk" />
    <meta name="robots" content="index, follow" />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Taunton Somerset Directory" />
    <meta property="og:locale" content="en_GB" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    
    <!-- Geo Meta Tags for Local SEO -->
    <meta name="geo.region" content="GB-SOM" />
    <meta name="geo.placename" content="Taunton" />
    <meta name="geo.position" content="51.0184;-3.1006" />
    <meta name="ICBM" content="51.0184, -3.1006" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Sitemap -->
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    
    <!-- JSON-LD Structured Data for Local Business -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Taunton Somerset Business Directory",
      "description": "Local business directory for Taunton, Somerset",
      "url": siteUrl,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Taunton",
        "addressRegion": "Somerset",
        "addressCountry": "GB"
      },
      "areaServed": {
        "@type": "City",
        "name": "Taunton",
        "containedIn": {
          "@type": "AdministrativeArea",
          "name": "Somerset"
        }
      }
    })} />
    
    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
  </head>
  <body class="bg-gray-50 text-gray-900">
    <slot />
  </body>
</html>
