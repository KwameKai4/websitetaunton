---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Terms of Service - Taunton Somerset Directory"
  description="Terms of Service for Taunton Somerset Business Directory. Read our terms and conditions for using our directory service."
>
  <Navigation />
  
  <!-- Page Header -->
  <div class="bg-gradient-to-r from-blue-600 to-blue-800 text-white py-16">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Terms of Service</h1>
      <p class="text-xl text-blue-100 max-w-2xl mx-auto">
        Terms and conditions for using our directory
      </p>
    </div>
  </div>
  
  <main class="container mx-auto px-4 py-16">
    <div class="max-w-4xl mx-auto bg-white rounded-lg shadow-lg p-8 md:p-12">
      <p class="text-sm text-gray-600 mb-8">Last Updated: December 2024</p>
      
      <div class="prose prose-lg max-w-none">
        <section class="mb-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Agreement to Terms</h2>
          <p class="text-gray-700 leading-relaxed mb-4">
            By accessing and using TauntonSomerset.co.uk ("the Site"), you agree to be bound by these Terms of Service. If you do not agree to these terms, please do not use our service.
          </p>
        </section>
        
        <section class="mb-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Use of Service</h2>
          <p class="text-gray-700 leading-relaxed mb-4">
            Our directory service is provided to help users find local businesses in Taunton and Somerset. You agree to:
          </p>
          <ul class="list-disc pl-6 text-gray-700 mb-4 space-y-2">
            <li>Use the service for lawful purposes only</li>
            <li>Not attempt to harm or disrupt the service</li>
            <li>Not use automated systems to access or scrape content</li>
            <li>Respect the intellectual property rights of others</li>
            <li>Provide accurate information when submitting a listing request</li>
          </ul>
        </section>
        
        <section class="mb-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Business Listings</h2>
          
          <h3 class="text-xl font-semibold text-gray-900 mb-3">Listing Submission</h3>
          <p class="text-gray-700 leading-relaxed mb-4">
            When you submit your business for listing:
          </p>
          <ul class="list-disc pl-6 text-gray-700 mb-4 space-y-2">
            <li>You warrant that all information provided is accurate and current</li>
            <li>You authorize us to display your business information publicly</li>
            <li>You agree to notify us of any changes to your business information</li>
            <li>You understand that we reserve the right to approve or reject any listing</li>
          </ul>
          
          <h3 class="text-xl font-semibold text-gray-900 mb-3">Listing Accuracy</h3>
          <p class="text-gray-700 leading-relaxed mb-4">
            While we strive to maintain accurate information, we do not guarantee the accuracy, completeness, or timeliness of business listings. Businesses are responsible for keeping their information up to date.
          </p>
          
          <h3 class="text-xl font-semibold text-gray-900 mb-3">Removal of Listings</h3>
          <p class="text-gray-700 leading-relaxed mb-4">
            We reserve the right to remove any listing at our discretion, including but not limited to listings that:
          </p>
          <ul class="list-disc pl-6 text-gray-700 mb-4 space-y-2">
            <li>Contain false or misleading information</li>
            <li>Violate any laws or regulations</li>
            <li>Are deemed inappropriate or harmful</li>
            <li>Receive repeated complaints</li>
          </ul>
        </section>
        
        <section class="mb-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Disclaimer of Warranties</h2>
          <p class="text-gray-700 leading-relaxed mb-4">
            The directory is provided "as is" without warranties of any kind. We do not:
          </p>
          <ul class="list-disc pl-6 text-gray-700 mb-4 space-y-2">
            <li>Guarantee the quality of services provided by listed businesses</li>
            <li>Endorse or recommend any specific business</li>
            <li>Accept responsibility for interactions between users and businesses</li>
            <li>Warrant that the service will be uninterrupted or error-free</li>
          </ul>
        </section>
        
        <section class="mb-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Limitation of Liability</h2>
          <p class="text-gray-700 leading-relaxed mb-4">
            To the maximum extent permitted by law, TauntonSomerset.co.uk shall not be liable for:
          </p>
          <ul class="list-disc pl-6 text-gray-700 mb-4 space-y-2">
            <li>Any damages arising from your use of the service</li>
            <li>Services provided by businesses listed in our directory</li>
            <li>Any inaccuracies in business listings</li>
            <li>Loss of data or business opportunities</li>
            <li>Indirect, incidental, or consequential damages</li>
          </ul>
        </section>
        
        <section class="mb-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Third-Party Services</h2>
          <p class="text-gray-700 leading-relaxed mb-4">
            Our directory contains links to third-party websites and businesses. We are not responsible for:
          </p>
          <ul class="list-disc pl-6 text-gray-700 mb-4 space-y-2">
            <li>The content, privacy policies, or practices of third-party sites</li>
            <li>Products or services offered by listed businesses</li>
            <li>Any transactions between you and listed businesses</li>
          </ul>
        </section>
        
        <section class="mb-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Intellectual Property</h2>
          <p class="text-gray-700 leading-relaxed mb-4">
            All content on this site, including text, graphics, logos, and design, is the property of TauntonSomerset.co.uk or its content suppliers and is protected by copyright laws.
          </p>
          <p class="text-gray-700 leading-relaxed mb-4">
            Business information provided for listings remains the property of the respective businesses.
          </p>
        </section>
        
        <section class="mb-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">User Conduct</h2>
          <p class="text-gray-700 leading-relaxed mb-4">
            You agree not to:
          </p>
          <ul class="list-disc pl-6 text-gray-700 mb-4 space-y-2">
            <li>Submit false or misleading information</li>
            <li>Impersonate another person or business</li>
            <li>Upload malicious code or viruses</li>
            <li>Harass or abuse other users or businesses</li>
            <li>Violate any applicable laws or regulations</li>
          </ul>
        </section>
        
        <section class="mb-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Termination</h2>
          <p class="text-gray-700 leading-relaxed mb-4">
            We reserve the right to terminate or suspend access to our service immediately, without prior notice, for any violation of these Terms of Service.
          </p>
        </section>
        
        <section class="mb-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Changes to Terms</h2>
          <p class="text-gray-700 leading-relaxed mb-4">
            We may modify these terms at any time. Continued use of the service after changes constitutes acceptance of the modified terms. We will update the "Last Updated" date at the top of this page.
          </p>
        </section>
        
        <section class="mb-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Governing Law</h2>
          <p class="text-gray-700 leading-relaxed mb-4">
            These Terms of Service are governed by the laws of England and Wales. Any disputes shall be subject to the exclusive jurisdiction of the courts of England and Wales.
          </p>
        </section>
        
        <section class="mb-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Contact Information</h2>
          <p class="text-gray-700 leading-relaxed mb-4">
            If you have questions about these Terms of Service, please contact us:
          </p>
          <div class="bg-blue-50 rounded-lg p-6">
            <p class="text-gray-700 mb-2">
              <strong>Email:</strong> <a href="mailto:info@tauntonsomerset.co.uk" class="text-blue-600 hover:text-blue-800">info@tauntonsomerset.co.uk</a>
            </p>
            <p class="text-gray-700">
              <strong>Address:</strong> Taunton, Somerset, United Kingdom
            </p>
          </div>
        </section>
        
        <section class="mb-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Severability</h2>
          <p class="text-gray-700 leading-relaxed mb-4">
            If any provision of these Terms is found to be unenforceable, the remaining provisions will continue in full force and effect.
          </p>
        </section>
      </div>
    </div>
  </main>
  
  <Footer />
</Layout>
