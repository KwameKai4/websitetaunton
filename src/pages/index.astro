---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import CategorySection from '../components/CategorySection.astro';
import Footer from '../components/Footer.astro';
import businessData from '../data/businesses.json';

// Group businesses by category
const businessesByCategory = businessData.businesses.reduce((acc, business) => {
  if (!acc[business.category]) {
    acc[business.category] = [];
  }
  acc[business.category].push(business);
  return acc;
}, {} as Record<string, typeof businessData.businesses>);

// Get unique categories sorted alphabetically
const categories = Object.keys(businessesByCategory).sort();
---

<Layout>
  <Navigation />
  <Hero />
  
  <!-- Category Navigation -->
  <nav class="sticky top-0 z-10 bg-white shadow-md">
    <div class="container mx-auto px-4 py-4">
      <div class="flex flex-wrap justify-center gap-3">
        {categories.map((category) => (
          <a 
            href={`#${category.toLowerCase().replace(/\s+/g, '-')}`}
            class="px-4 py-2 bg-blue-100 hover:bg-blue-600 hover:text-white text-blue-800 rounded-full font-medium transition-colors duration-200 text-sm md:text-base"
          >
            {category}
          </a>
        ))}
      </div>
    </div>
  </nav>
  
  <!-- Main Content -->
  <main class="container mx-auto px-4 py-12">
    <!-- Intro Section -->
    <div class="max-w-3xl mx-auto text-center mb-16">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4">
        Discover Trusted Local Businesses in Taunton
      </h2>
      <p class="text-lg text-gray-700 leading-relaxed">
        Browse our comprehensive directory of local services. From emergency plumbers to professional cleaners, 
        find reliable businesses in your area. All listings are verified and trusted by the Taunton community.
      </p>
    </div>
    
    <!-- Business Listings by Category -->
    {categories.map((category) => (
      <CategorySection 
        category={category}
        businesses={businessesByCategory[category]}
      />
    ))}
    
    <!-- Call to Action -->
    <div class="bg-gradient-to-r from-blue-600 to-blue-800 text-white rounded-2xl p-8 md:p-12 text-center mt-16">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Want to List Your Business?</h2>
      <p class="text-xl text-blue-100 mb-6 max-w-2xl mx-auto">
        Join our growing directory and connect with customers in Taunton and surrounding areas.
      </p>
      <a 
        href="mailto:info@tauntonsomerset.co.uk" 
        class="inline-block bg-white text-blue-600 font-bold px-8 py-3 rounded-lg hover:bg-blue-50 transition-colors text-lg"
      >
        Get Listed Today
      </a>
    </div>
  </main>
  
  <Footer />
</Layout>
