---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import businessData from '../data/businesses.json';

// Group businesses by category and count them
const businessesByCategory = businessData.businesses.reduce((acc, business) => {
  if (!acc[business.category]) {
    acc[business.category] = [];
  }
  acc[business.category].push(business);
  return acc;
}, {} as Record<string, typeof businessData.businesses>);

// Get categories with counts, sorted alphabetically
const categoriesWithCounts = Object.entries(businessesByCategory)
  .map(([category, businesses]) => ({
    name: category,
    count: businesses.length,
    slug: category.toLowerCase().replace(/\s+/g, '-')
  }))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<Layout 
  title="All Categories - Taunton Somerset Business Directory"
  description="Browse all business categories in Taunton Somerset. Find plumbers, cleaners, electricians, builders, gardeners and more local services in your area."
>
  <Navigation />
  
  <!-- Page Header -->
  <div class="bg-gradient-to-r from-blue-600 to-blue-800 text-white py-16">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">All Categories</h1>
      <p class="text-xl text-blue-100 max-w-2xl mx-auto">
        Browse our complete directory of local business categories
      </p>
    </div>
  </div>
  
  <main class="container mx-auto px-4 py-16">
    <div class="max-w-5xl mx-auto">
      <!-- Introduction -->
      <div class="text-center mb-12">
        <p class="text-lg text-gray-700">
          Explore {categoriesWithCounts.length} categories with {businessData.businesses.length} trusted local businesses serving Taunton and Somerset
        </p>
      </div>
      
      <!-- Category Tabs -->
      <div class="bg-white rounded-lg shadow-md p-6 mb-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">Browse by Category</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-3">
          {categoriesWithCounts.map((category) => {
            const icon = {
              'Plumbers': '🔧',
              'Cleaners': '🧽',
              'Electricians': '⚡',
              'Builders': '🏗️',
              'Gardeners': '🌱',
              'Painters & Decorators': '🎨',
              'Barbers': '✂️',
              'Hairdressers': '💇‍♀️',
              'Florists': '🌸',
              'Restaurants': '🍽️',
              'Cafes': '☕',
              'Takeaways': '🥡',
              'Estate Agents': '🏠',
              'Solicitors': '⚖️',
              'Dentists': '🦷',
              'Veterinary Services': '🐾',
              'Pharmacies': '💊',
              'Newsagents': '📰',
              'Butchers': '🥩',
              'Bakers': '🍞',
              'Grocers': '🛒',
              'Accountants': '🧮'
            }[category.name] || '🏢';
            
            return (
              <a 
                href={`/#${category.slug}`}
                class="flex flex-col items-center justify-center p-4 bg-gray-50 hover:bg-blue-50 border border-gray-200 hover:border-blue-300 rounded-lg transition-all duration-200 group text-center"
              >
                <span class="text-2xl mb-2" role="img" aria-label={`${category.name} icon`}>{icon}</span>
                <h3 class="text-sm font-semibold text-gray-900 group-hover:text-blue-600 transition-colors leading-tight">
                  {category.name}
                </h3>
                <span class="text-xs text-gray-500 mt-1 bg-white px-2 py-1 rounded-full">
                  {category.count}
                </span>
              </a>
            );
          })}
        </div>
      </div>
      
      <!-- Popular Services -->
      <div class="mt-16 bg-gradient-to-br from-blue-50 to-blue-100 rounded-lg p-8 md:p-12">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-6 text-center">
          Popular Local Services in Taunton
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
          <div class="bg-white rounded-lg p-4 shadow">
            <div class="text-3xl mb-2">✂️</div>
            <p class="font-semibold text-gray-900">Barbers</p>
          </div>
          <div class="bg-white rounded-lg p-4 shadow">
            <div class="text-3xl mb-2">🌸</div>
            <p class="font-semibold text-gray-900">Florists</p>
          </div>
          <div class="bg-white rounded-lg p-4 shadow">
            <div class="text-3xl mb-2">🍽️</div>
            <p class="font-semibold text-gray-900">Restaurants</p>
          </div>
          <div class="bg-white rounded-lg p-4 shadow">
            <div class="text-3xl mb-2">☕</div>
            <p class="font-semibold text-gray-900">Cafes</p>
          </div>
          <div class="bg-white rounded-lg p-4 shadow">
            <div class="text-3xl mb-2">🏠</div>
            <p class="font-semibold text-gray-900">Estate Agents</p>
          </div>
          <div class="bg-white rounded-lg p-4 shadow">
            <div class="text-3xl mb-2">🦷</div>
            <p class="font-semibold text-gray-900">Dentists</p>
          </div>
          <div class="bg-white rounded-lg p-4 shadow">
            <div class="text-3xl mb-2">🐾</div>
            <p class="font-semibold text-gray-900">Vets</p>
          </div>
          <div class="bg-white rounded-lg p-4 shadow">
            <div class="text-3xl mb-2">🍞</div>
            <p class="font-semibold text-gray-900">Bakers</p>
          </div>
        </div>
      </div>
      
      <!-- Call to Action -->
      <div class="mt-16 bg-white rounded-lg shadow-lg p-8 md:p-12 text-center">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4">
          Can't Find What You're Looking For?
        </h2>
        <p class="text-lg text-gray-700 mb-6 max-w-2xl mx-auto">
          We're always adding new categories and businesses. If you have a specific service in mind, get in touch and we'll help you find the right local business.
        </p>
        <a 
          href="/contact" 
          class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-bold px-8 py-3 rounded-lg transition-colors"
        >
          Contact Us
        </a>
      </div>
    </div>
  </main>
  
  <Footer />
</Layout>
