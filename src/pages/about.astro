---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="About Us - Taunton Somerset Local Business Directory"
  description="Learn about Taunton Somerset Directory - your trusted source for finding quality local businesses and services in Taunton and surrounding Somerset areas."
>
  <Navigation />
  
  <!-- Page Header -->
  <div class="bg-gradient-to-r from-blue-600 to-blue-800 text-white py-16">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">About Us</h1>
      <p class="text-xl text-blue-100 max-w-2xl mx-auto">
        Connecting Taunton's community with trusted local businesses
      </p>
    </div>
  </div>
  
  <main class="container mx-auto px-4 py-16">
    <!-- Mission Section -->
    <div class="max-w-4xl mx-auto mb-16">
      <div class="bg-white rounded-lg shadow-lg p-8 md:p-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-6">Our Mission</h2>
        <p class="text-lg text-gray-700 leading-relaxed mb-4">
          Taunton Somerset Directory was created to bridge the gap between local residents and the excellent businesses that serve our community. We understand how important it is to find reliable, trustworthy tradespeople and service providers when you need them most.
        </p>
        <p class="text-lg text-gray-700 leading-relaxed">
          Our mission is simple: to make it easy for people in Taunton and surrounding Somerset areas to discover and connect with quality local businesses, while helping those businesses reach more customers in their community.
        </p>
      </div>
    </div>
    
    <!-- Why Choose Us -->
    <div class="max-w-6xl mx-auto mb-16">
      <h2 class="text-3xl font-bold text-gray-900 text-center mb-12">Why Choose Our Directory?</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Local Focus -->
        <div class="bg-white rounded-lg shadow-lg p-8 text-center">
          <div class="bg-blue-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Local Focus</h3>
          <p class="text-gray-700">
            Exclusively featuring businesses serving Taunton and the surrounding Somerset area, ensuring you get local expertise.
          </p>
        </div>
        
        <!-- Easy to Use -->
        <div class="bg-white rounded-lg shadow-lg p-8 text-center">
          <div class="bg-blue-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Easy to Use</h3>
          <p class="text-gray-700">
            Browse by category, find what you need quickly, and contact businesses directly with click-to-call and email features.
          </p>
        </div>
        
        <!-- Trusted Listings -->
        <div class="bg-white rounded-lg shadow-lg p-8 text-center">
          <div class="bg-blue-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Trusted Listings</h3>
          <p class="text-gray-700">
            All businesses are verified before being listed, giving you confidence in the services you find.
          </p>
        </div>
      </div>
    </div>
    
    <!-- What We Offer -->
    <div class="max-w-4xl mx-auto mb-16">
      <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-lg p-8 md:p-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-6">What We Offer</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="flex items-start gap-3">
            <svg class="w-6 h-6 text-blue-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <div>
              <h4 class="font-semibold text-gray-900 mb-1">Comprehensive Categories</h4>
              <p class="text-gray-700 text-sm">From plumbers to gardeners, find all types of local services</p>
            </div>
          </div>
          
          <div class="flex items-start gap-3">
            <svg class="w-6 h-6 text-blue-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <div>
              <h4 class="font-semibold text-gray-900 mb-1">Direct Contact</h4>
              <p class="text-gray-700 text-sm">Phone, email, and website links for easy communication</p>
            </div>
          </div>
          
          <div class="flex items-start gap-3">
            <svg class="w-6 h-6 text-blue-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <div>
              <h4 class="font-semibold text-gray-900 mb-1">Mobile Friendly</h4>
              <p class="text-gray-700 text-sm">Access on any device, anytime you need it</p>
            </div>
          </div>
          
          <div class="flex items-start gap-3">
            <svg class="w-6 h-6 text-blue-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <div>
              <h4 class="font-semibold text-gray-900 mb-1">Regular Updates</h4>
              <p class="text-gray-700 text-sm">Fresh listings and verified information</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- For Businesses -->
    <div class="max-w-4xl mx-auto">
      <div class="bg-white rounded-lg shadow-lg p-8 md:p-12 text-center">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Are You a Local Business?</h2>
        <p class="text-lg text-gray-700 mb-8 max-w-2xl mx-auto">
          Join our directory and connect with customers actively looking for your services in the Taunton area. Get featured, gain visibility, and grow your local customer base.
        </p>
        <a 
          href="/contact" 
          class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-bold px-8 py-3 rounded-lg transition-colors text-lg"
        >
          List Your Business
        </a>
      </div>
    </div>
  </main>
  
  <Footer />
</Layout>
