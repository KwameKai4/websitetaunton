---
---

<nav class="bg-white shadow-lg sticky top-0 z-50">
  <div class="container mx-auto px-4">
    <div class="flex items-center justify-between h-16">
      <!-- Logo/Brand -->
      <a href="/" class="flex items-center space-x-2 text-xl font-bold text-blue-600 hover:text-blue-800 transition-colors">
        <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 100 100">
          <rect width="100" height="100" rx="15" fill="currentColor"/>
          <text x="50" y="70" font-family="Arial, sans-serif" font-size="60" font-weight="bold" fill="white" text-anchor="middle">T</text>
        </svg>
        <span class="hidden sm:inline">Taunton Somerset</span>
      </a>
      
      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-6">
        <a href="/" class="text-gray-700 hover:text-blue-600 font-medium transition-colors">Home</a>
        <a href="/about" class="text-gray-700 hover:text-blue-600 font-medium transition-colors">About</a>
        <a href="/categories" class="text-gray-700 hover:text-blue-600 font-medium transition-colors">All Categories</a>
        <a href="/contact" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-medium transition-colors">
          List Your Business
        </a>
      </div>
      
      <!-- Mobile Menu Button -->
      <button id="mobile-menu-button" class="md:hidden text-gray-700 hover:text-blue-600 focus:outline-none">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
    
    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden md:hidden pb-4">
      <div class="flex flex-col space-y-3">
        <a href="/" class="text-gray-700 hover:text-blue-600 font-medium transition-colors py-2">Home</a>
        <a href="/about" class="text-gray-700 hover:text-blue-600 font-medium transition-colors py-2">About</a>
        <a href="/categories" class="text-gray-700 hover:text-blue-600 font-medium transition-colors py-2">All Categories</a>
        <a href="/contact" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-medium transition-colors text-center">
          List Your Business
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  // Mobile menu toggle
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  
  menuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>
