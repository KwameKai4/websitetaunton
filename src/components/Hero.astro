<header class="bg-gradient-to-r from-blue-600 to-blue-800 text-white">
  <div class="container mx-auto px-4 py-16 md:py-24">
    <div class="text-center max-w-4xl mx-auto">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">
        Taunton Somerset
        <span class="block text-blue-200 mt-2">Local Business Directory</span>
      </h1>
      <p class="text-xl md:text-2xl text-blue-100 mb-8">
        Find trusted local services in Taunton and surrounding areas
      </p>
      <p class="text-lg text-blue-50 max-w-2xl mx-auto">
        Connect with reliable plumbers, cleaners, electricians, builders, and more. 
        Your local community directory for quality services.
      </p>
    </div>
  </div>
  
  <!-- Decorative wave -->
  <div class="relative">
    <svg class="w-full h-12 md:h-16 text-gray-50" viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path d="M0 80L60 73.3C120 66.7 240 53.3 360 46.7C480 40 600 40 720 46.7C840 53.3 960 66.7 1080 66.7C1200 66.7 1320 53.3 1380 46.7L1440 40V80H1380C1320 80 1200 80 1080 80C960 80 840 80 720 80C600 80 480 80 360 80C240 80 120 80 60 80H0Z" fill="currentColor"/>
    </svg>
  </div>
</header>
