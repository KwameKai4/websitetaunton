---
const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 text-gray-300 mt-20">
  <div class="container mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      <!-- About -->
      <div>
        <h3 class="text-white text-lg font-bold mb-4">Taunton Somerset Directory</h3>
        <p class="text-sm leading-relaxed mb-4">
          Your trusted local business directory connecting residents of Taunton, Somerset with quality local services and tradespeople.
        </p>
        <div class="flex space-x-3">
          <a href="#" class="text-gray-400 hover:text-blue-400 transition-colors" aria-label="Facebook">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="#" class="text-gray-400 hover:text-blue-400 transition-colors" aria-label="Twitter">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
          </a>
        </div>
      </div>
      
      <!-- Quick Links -->
      <div>
        <h3 class="text-white text-lg font-bold mb-4">Quick Links</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/" class="hover:text-blue-400 transition-colors">Home</a></li>
          <li><a href="/about" class="hover:text-blue-400 transition-colors">About Us</a></li>
          <li><a href="/categories" class="hover:text-blue-400 transition-colors">All Categories</a></li>
          <li><a href="/contact" class="hover:text-blue-400 transition-colors">Contact</a></li>
          <li><a href="/privacy" class="hover:text-blue-400 transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-blue-400 transition-colors">Terms of Service</a></li>
        </ul>
      </div>
      
      <!-- Categories -->
      <div>
        <h3 class="text-white text-lg font-bold mb-4">Popular Categories</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/#plumbers" class="hover:text-blue-400 transition-colors">Plumbers</a></li>
          <li><a href="/#cleaners" class="hover:text-blue-400 transition-colors">Cleaners</a></li>
          <li><a href="/#electricians" class="hover:text-blue-400 transition-colors">Electricians</a></li>
          <li><a href="/#builders" class="hover:text-blue-400 transition-colors">Builders</a></li>
          <li><a href="/#gardeners" class="hover:text-blue-400 transition-colors">Gardeners</a></li>
          <li><a href="/#painters-&-decorators" class="hover:text-blue-400 transition-colors">Painters & Decorators</a></li>
        </ul>
      </div>
      
      <!-- Contact Info -->
      <div>
        <h3 class="text-white text-lg font-bold mb-4">Get In Touch</h3>
        <ul class="space-y-3 text-sm">
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 text-blue-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href="mailto:info@tauntonsomerset.co.uk" class="hover:text-blue-400 transition-colors">
              info@tauntonsomerset.co.uk
            </a>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 text-blue-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Taunton, Somerset<br>United Kingdom</span>
          </li>
        </ul>
        <a href="/contact" class="inline-block mt-4 bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2 rounded-lg transition-colors text-sm">
          List Your Business
        </a>
      </div>
    </div>
    
    <!-- Bottom Bar -->
    <div class="border-t border-gray-800 pt-8">
      <div class="flex flex-col md:flex-row justify-between items-center text-sm text-center md:text-left">
        <p>&copy; {currentYear} TauntonSomerset.co.uk - All rights reserved.</p>
        <p class="mt-2 md:mt-0 text-gray-400">Serving Taunton, Somerset and surrounding areas</p>
      </div>
    </div>
  </div>
</footer>
