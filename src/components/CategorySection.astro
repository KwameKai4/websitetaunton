---
import BusinessCard from './BusinessCard.astro';

interface Business {
  id: number;
  name: string;
  category: string;
  description: string;
  phone: string;
  email: string;
  address: string;
  website?: string;
  featured?: boolean;
}

interface Props {
  category: string;
  businesses: Business[];
}

const { category, businesses } = Astro.props;

// Category icons mapping
const categoryIcons = {
  'Plumbers': '🔧',
  'Cleaners': '🧽',
  'Electricians': '⚡',
  'Builders': '🏗️',
  'Gardeners': '🌱',
  'Painters & Decorators': '🎨',
  'Barbers': '✂️',
  'Hairdressers': '💇‍♀️',
  'Florists': '🌸',
  'Restaurants': '🍽️',
  'Cafes': '☕',
  'Takeaways': '🥡',
  'Estate Agents': '🏠',
  'Solicitors': '⚖️',
  'Dentists': '🦷',
  'Veterinary Services': '🐾',
  'Pharmacies': '💊',
  'Newsagents': '📰',
  'Butchers': '🥩',
  'Bakers': '🍞',
  'Grocers': '🛒',
  'Accountants': '🧮'
};

// Get icon for category, fallback to default
const getCategoryIcon = (cat: string) => (categoryIcons as any)[cat] || '🏢';

// Sort businesses: featured first, then alphabetically
const sortedBusinesses = businesses.sort((a, b) => {
  if (a.featured && !b.featured) return -1;
  if (!a.featured && b.featured) return 1;
  return a.name.localeCompare(b.name);
});
---

<section id={category.toLowerCase().replace(/\s+/g, '-')} class="mb-16 scroll-mt-24">
  <div class="mb-8">
    <div class="flex items-center mb-4">
      <span class="text-4xl mr-4" role="img" aria-label={`${category} icon`}>{getCategoryIcon(category)}</span>
      <div>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">{category}</h2>
        <p class="text-gray-600">{businesses.length} business{businesses.length !== 1 ? 'es' : ''} in this category</p>
      </div>
    </div>
    <div class="w-20 h-1 bg-blue-600 rounded"></div>
  </div>
  
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {sortedBusinesses.map((business) => (
      <BusinessCard
        name={business.name}
        category={business.category}
        description={business.description}
        phone={business.phone}
        email={business.email}
        address={business.address}
        website={business.website}
        featured={business.featured}
      />
    ))}
  </div>
</section>
